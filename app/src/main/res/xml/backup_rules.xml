<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud auto-backup is disabled by default because the database can contain
    sensitive financial data.  Users take explicit backups from Settings.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
