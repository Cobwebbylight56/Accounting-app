<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A minimal platform theme.  All real styling is done in Compose
        (ui/theme/Theme.kt); this only controls the launch window so that the
        app does not flash a white screen in dark mode.
    -->
    <style name="Theme.FinanceTracker" parent="android:Theme.Material.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
